# -----------------------
# Toolchain
# -----------------------
CC = arm-none-eabi-gcc

# -----------------------
# Project paths
# -----------------------
OBJDIR = Object
BUILDDIR = build
OUT = $(BUILDDIR)/main.elf

# -----------------------
# Flags
# -----------------------
CFLAGS = --specs=nano.specs \
          -mcpu=cortex-m3 -mthumb -std=c11 -Wall -g -O0 \
          -I. \
          -Iinclude \
          -IApp \
          -ISystem \
          -IBsw/Mcal \
          -IBsw/Mcal/Dio/inc \
          -IBsw/Mcal/Gpt/inc \
          -IBsw/Mcal/Port/inc \
          -IBsw/Mcal/Mcu/inc \
          -IBsw/Mcal/Spi/inc \
          -IBsw/Services\
          -IBsw/Services/Common\
          -IBsw/Services/Os\
          -Ilib/CMSIS \
          -Ilib/SPL/inc \
          -Istartup \
          -DSTM32F10X_MD -DUSE_STDPERIPH_DRIVER 

LDFLAGS = -T linker.ld -Wl,-Map=$(BUILDDIR)/main.map -nostartfiles

# -----------------------
# Sources and objects
# -----------------------
SRC = $(wildcard App/main.c) \
      $(wildcard System/*.c) \
      $(wildcard Bsw/Mcal/Dio/src/*.c) \
      $(wildcard Bsw/Mcal/Gpt/src/*.c) \
      $(wildcard Bsw/Mcal/Port/src/*.c) \
      $(wildcard Bsw/Mcal/Mcu/src/*.c) \
      $(wildcard Bsw/Mcal/Spi/src/*.c) \
      $(wildcard Bsw/Services/Os/*.c) \
      $(wildcard lib/SPL/src/*.c) \

STARTUP = startup/startup_stm32f103c8tx.s
OBJ = $(patsubst %.c,$(OBJDIR)/%.o,$(SRC)) \
      $(patsubst %.s,$(OBJDIR)/%.o,$(STARTUP))

# -----------------------
# Rules
# -----------------------
.RECIPEPREFIX := >

$(OBJDIR)/%.o: %.c
>@mkdir -p $(dir $@)
>$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

$(OBJDIR)/%.o: %.s
>@mkdir -p $(dir $@)
>$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

# Include dependencies generated by GCC so header changes rebuild affected objects.
DEP = $(OBJ:.o=.d)
-include $(DEP)

build: $(OUT)

$(OUT): $(OBJ)
>@mkdir -p $(BUILDDIR)
>$(CC) $(CFLAGS) $(OBJ) -o $@ $(LDFLAGS)
>@echo "==================================="
>@echo "✓ Compilation SUCCESSFUL!"
>@echo "Output: $(OUT)"
>@echo "==================================="

clean:
>rm -rf $(OBJDIR) $(BUILDDIR)/*.elf $(BUILDDIR)/*.map

flash: $(OUT)
>openocd -f interface/stlink.cfg -f target/stm32f1x.cfg \
>	-c "program $(OUT) verify reset exit"