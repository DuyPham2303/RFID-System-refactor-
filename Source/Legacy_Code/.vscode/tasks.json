{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build STM32",
      "type": "shell",
      "command": "make",
      "args": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Compile the STM32 firmware using Makefile"
    },
    {
      "type": "cppbuild",
      "label": "Build-C-program",
      "command": "C:/MinGW/msys64/mingw64/bin/gcc.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "-std=c17",
        "${file}",
        "-o",
        //"${fileDirname}\\${fileBasenameNoExtension}.exe"
        "${workspaceFolder}/build/demo.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "C:\\MinGW\\msys64\\mingw64\\bin\\gcc.exe"
    },
    {
      "label": "Open Terminal at Current File",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/Script/cd_to_current_file.sh",
        "${file}"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new"
      },
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ],
}